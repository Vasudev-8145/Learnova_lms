

# ============ REGISTRATION,AUTHENTICATION,PROFILE ================= #

# api call for trainer registration
###
POST http://127.0.0.1:8000/accounts/trainer/
Content-Type: application/json

{
    "username":"trainer3",
    "email":"trainer3@gmail.come",
    "password":"trainer3@123",
    "phone":789486127
}

# api call for student registration
###
POST http://127.0.0.1:8000/accounts/student/
Content-Type: application/json

{
    "username":"student3",
    "email":"student3@gmail.come",
    "password":"student3@123",
    "phone":989456178
}

# api call for token creation
###
POST http://127.0.0.1:8000/accounts/token/
Content-Type: application/json

{
    "username":"trainer1",
    "password":"trainer1@123"
}

# api call for trainer profile update
###
PUT http://127.0.0.1:8000/accounts/trainer/profile/complete/
Content-Type: application/json
Authorization: Token 01ba2b7eeadfe96e6e631aebec5513fdb5bfb4d9

{
    "specialization":"python django",
    "skills":"python,django,sql,html,css,js,bootstrap,react",
    "qualification":"mca cs",
    "experience":"8 years"
}

# api call for trainer profile retreiving
###
GET http://127.0.0.1:8000/accounts/trainer/profile/me/
Accept: application/json
Authorization: Token 01ba2b7eeadfe96e6e631aebec5513fdb5bfb4d9


# ============ COURSE CRUD ================= #


# api call for listing courses
###
GET http://127.0.0.1:8000/subject/course/all/
Accept: application/json
Authorization: Token 01ba2b7eeadfe96e6e631aebec5513fdb5bfb4d9

# api call for creating courses
###
POST http://127.0.0.1:8000/subject/course/add/
Content-Type: application/json
Authorization: Token 01ba2b7eeadfe96e6e631aebec5513fdb5bfb4d9

{
    "title":"Python Django Full Stack",
    "description":"AI integrated python full stack development course.",
    "fees":45000,
    "duration":"7 months",
    "languages":"Python,Django,SQL,React.js,HTML5,CSS,Javascript"
}

